! la-2 = acceso (solo usuarios)
! e0 -> la-1 (e4) | e1 -> PC1 | e2 -> PC2
! Nombres asumidos (IOSvL2): e0=Gi0/0 e1=Gi0/1 e2=Gi0/2
enable
configure terminal
hostname SW2-ACCESO
no ip domain-lookup

vlan 10
 name USUARIOS-10
vlan 20
 name USUARIOS-20
 exit

! e0 -> la-1
interface GigabitEthernet0/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
 exit

! e1 -> PC1 (VLAN 10)
interface GigabitEthernet0/1
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
 exit

! e2 -> PC2 (VLAN 20)
interface GigabitEthernet0/2
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 no shutdown
 exit

end
write memory
