! la-1 = distribucion (FortiGate + servidores + enlace a la-2)
! e0 -> FortiGate port3 | e1 -> server1 | e2 -> server2 | e3 -> server3 | e4 -> la-2
! Nombres asumidos (IOSvL2): e0=Gi0/0 e1=Gi0/1 e2=Gi0/2 e3=Gi0/3 e4=Gi1/0
enable
configure terminal
hostname SW1-DIST
no ip domain-lookup

vlan 10
 name USUARIOS-10
vlan 20
 name USUARIOS-20
vlan 30
 name DMZ-SERVIDORES
 exit

! e0 -> FortiGate port3
interface GigabitEthernet0/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30
 no shutdown
 exit

! e4 -> la-2
interface GigabitEthernet1/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20
 no shutdown
 exit

! e1, e2, e3 -> servidores (VLAN 30)
interface range GigabitEthernet0/1 - 3
 switchport mode access
 switchport access vlan 30
 spanning-tree portfast
 no shutdown
 exit

end
write memory
